{
  "name": "community-selection-miniapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter @community-selection/api --filter @community-selection/admin dev",
    "build": "pnpm --filter @community-selection/shared build && pnpm --filter @community-selection/config build && pnpm --filter @community-selection/api build && pnpm --filter @community-selection/admin build",
    "lint": "node scripts/lint-placeholder.js",
    "typecheck": "pnpm --filter @community-selection/shared build && pnpm --filter @community-selection/config build && pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio --schema prisma/schema.prisma",
    "env:check": "tsx scripts/validate-env.ts",
    "migrations:check": "tsx scripts/check-migrations.ts",
    "compliance:scan": "tsx scripts/compliance-scan.ts",
    "verify:all": "bash scripts/verify-all-local.sh",
    "seed:check": "tsx scripts/check-seed-data.ts",
    "db:backup": "bash scripts/pg-backup.sh",
    "db:restore": "bash scripts/pg-restore.sh"
  },
  "devDependencies": {
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "@prisma/client": "^6.2.1",
    "@types/node": "^22.10.5"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3"
  }
}
