<view class="category-grid {{variant}}">
  <view
    wx:for="{{categories}}"
    wx:key="key"
    class="category-tile"
    data-keyword="{{item.keyword}}"
    data-testid="home-category-{{item.key}}"
    bindtap="chooseCategory"
  >
    <view class="category-photo">
      <image
        class="category-sprite-image"
        src="{{item.imagePath}}"
        style="left: {{item.spriteOffset}};"
        mode="scaleToFill"
      />
    </view>
    <view class="category-label">{{item.label}}</view>
  </view>
</view>
