.category-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12rpx; }
.category-tile { min-width: 0; padding: 22rpx 6rpx 18rpx; text-align: center; border-radius: 24rpx; }
.category-icon { font-size: 42rpx; line-height: 1.2; }
.category-label { margin-top: 10rpx; font-size: 23rpx; white-space: nowrap; }
