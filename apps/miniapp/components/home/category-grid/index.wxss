.category-grid { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12rpx; }
.category-tile { min-width: 0; padding: 0 0 16rpx; overflow: hidden; text-align: center; border-radius: 24rpx; }
.category-photo { position: relative; width: 100%; height: 104rpx; overflow: hidden; }
.category-sprite-image { position: absolute; top: -75%; width: 500%; height: 250%; display: block; }
.category-label { margin-top: 12rpx; font-size: 23rpx; white-space: nowrap; }
