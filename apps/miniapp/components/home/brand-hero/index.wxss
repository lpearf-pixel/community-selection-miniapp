.brand-hero { padding: 0; overflow: hidden; }
.brand-main { display: flex; align-items: center; }
.brand-main { padding: 24rpx 28rpx 20rpx; }
.brand-logo { width: 112rpx; height: 112rpx; flex: none; border-radius: 50%; }
.brand-copy { margin-left: 20rpx; min-width: 0; }
.brand-name { font-size: 42rpx; font-weight: 700; letter-spacing: 4rpx; }
.brand-subtitle { margin-top: 4rpx; font-size: 22rpx; letter-spacing: 6rpx; }
.brand-visual { position: relative; height: 320rpx; overflow: hidden; }
.brand-hero-image { width: 100%; height: 100%; display: block; }
.brand-visual-shade { position: absolute; top: 0; right: 0; bottom: 0; left: 0; background: linear-gradient(90deg, rgba(250, 247, 238, 0.96) 0%, rgba(250, 247, 238, 0.72) 36%, rgba(250, 247, 238, 0.04) 70%); }
.brand-visual-copy { position: absolute; left: 28rpx; top: 54rpx; width: 300rpx; }
.brand-slogan { font-size: 34rpx; line-height: 1.45; font-weight: 700; }
.brand-season { margin-top: 18rpx; font-size: 22rpx; letter-spacing: 2rpx; }
.service-row { display: flex; gap: 12rpx; padding: 20rpx 24rpx 24rpx; }
.service-pill { font-size: 22rpx; }
