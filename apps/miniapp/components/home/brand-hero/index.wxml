<view class="brand-hero cq-card {{variant}}" data-testid="home-brand">
  <view class="brand-main">
    <image class="brand-logo" src="{{brand.logoPath}}" mode="aspectFit" />
    <view class="brand-copy">
      <view class="brand-name">{{brand.name}}</view>
      <view class="brand-subtitle">{{brand.subtitle}}</view>
    </view>
  </view>
  <view class="brand-visual">
    <image class="brand-hero-image" src="{{brand.heroImagePath}}" mode="aspectFill" />
    <view class="brand-visual-shade"></view>
    <view class="brand-visual-copy">
      <view class="brand-slogan">{{brand.slogan}}</view>
      <view class="brand-season">时令鲜蔬 · 自然好味</view>
    </view>
  </view>
  <view class="service-row">
    <view wx:for="{{services}}" wx:key="key" class="cq-pill service-pill">{{item.label}}</view>
  </view>
</view>
