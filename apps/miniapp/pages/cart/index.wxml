<view class="cq-page page">
  <state-panel wx:if="{{!items.length}}" state="empty" message="购物车暂无商品" />
  <button wx:if="{{!items.length}}" class="cq-button cq-button--secondary browse-button" bindtap="goProducts">去逛逛</button>
  <view wx:else class="cart-list">
    <view wx:for="{{items}}" wx:key="product_id" class="cq-card cart-card">
      <checkbox checked="{{item.selected}}" bindtap="toggleItem" data-id="{{item.product_id}}" data-selected="{{item.selected}}" />
      <view class="cart-cover"><media-thumb src="{{item.cover_image}}" category-index="{{index}}" /></view>
      <view class="cart-info">
        <view class="cart-name">{{item.name}}</view>
        <view class="cq-muted cart-meta">{{item.spec_label || '默认规格'}}</view>
        <view class="cq-price cart-price">¥{{item.price_yuan}}</view>
        <view class="cart-subtotal">小计 ¥{{item.subtotal_yuan}}</view>
      </view>
      <view class="cart-ops">
        <view class="quantity-control">
          <button class="cq-button cq-button--secondary quantity-button" size="mini" bindtap="decrease" data-id="{{item.product_id}}" data-quantity="{{item.quantity}}">-</button>
          <input class="cq-input quantity-input" type="number" value="{{item.quantity}}" bindinput="onQuantityInput" data-id="{{item.product_id}}"/>
          <button class="cq-button cq-button--secondary quantity-button" size="mini" bindtap="increase" data-id="{{item.product_id}}" data-quantity="{{item.quantity}}">+</button>
        </view>
        <button class="cq-button cq-button--danger remove-button" size="mini" bindtap="removeItem" data-id="{{item.product_id}}">删除</button>
      </view>
    </view>
    <view class="cq-action-bar cart-action-bar">
      <button class="cq-button cq-button--secondary clear-button" size="mini" bindtap="clearAll">清空</button>
      <view class="cart-summary">已选 {{selectedCount}} 件 <text class="cq-price">¥{{selectedAmountYuan}}</text></view>
      <button class="cq-button cq-button--primary checkout-button" bindtap="checkout">去结算</button>
    </view>
  </view>
</view>
