.page { padding: 28rpx 28rpx 160rpx; }
.browse-button { width: 260rpx; margin: 0 auto; }
.cart-list { display: flex; flex-direction: column; gap: 18rpx; }
.cart-card { display: flex; align-items: center; gap: 16rpx; padding: 20rpx; }
.cart-cover { width: 132rpx; height: 132rpx; overflow: hidden; flex: none; border-radius: var(--cq-radius-control); }
.cart-info { min-width: 0; flex: 1; }
.cart-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 700; }
.cart-meta { margin-top: 7rpx; font-size: 23rpx; }
.cart-price { margin-top: 8rpx; }
.cart-subtotal { margin-top: 5rpx; font-size: 23rpx; }
.cart-ops { display: flex; flex-direction: column; gap: 12rpx; align-items: flex-end; }
.quantity-control { display: flex; align-items: center; gap: 6rpx; }
.quantity-button { width: 54rpx; height: 54rpx; padding: 0; }
.quantity-input { width: 68rpx; height: 54rpx; padding: 0 6rpx; text-align: center; }
.remove-button { width: 120rpx; height: 52rpx; font-size: 22rpx; }
.clear-button { width: 112rpx; }
.cart-summary { min-width: 0; flex: 1; text-align: right; font-size: 24rpx; }
.checkout-button { width: 184rpx; }
