<view class="page">
  <view class="panel">
    <view class="title">确认订单</view>
    <view wx:if="{{product}}" class="product"><view>{{product.name}}</view><view>单价：¥{{product.price_yuan}}</view><view class="muted">{{stock_label}}</view></view>
    <view class="row">购买类型：{{type === 'group_buy' ? '开团购买' : '普通购买'}}</view>
    <view wx:if="{{from_cart}}" class="row muted">来自购物车</view>
    <view class="row">数量</view><view class="quantity-box"><button size="mini" bindtap="decreaseQuantity" disabled="{{quantity <= 1}}">-</button><input class="quantity-input" type="number" value="{{quantity}}" bindinput="onQuantityInput" placeholder="数量" /><button size="mini" bindtap="increaseQuantity" disabled="{{product && product.stock <= 0}}">+</button></view>
    <view class="amounts"><view>购买数量：{{quantity}}</view><view>商品小计：¥{{subtotal_yuan}}</view><view class="pay">应付金额：¥{{pay_amount_yuan}}</view></view>
    <view class="section"><view class="row">履约方式</view><button size="mini" type="{{pickup_type === 'store' ? 'primary' : 'default'}}" data-type="store" bindtap="selectPickupType">到店自提</button><button size="mini" type="{{pickup_type === 'delivery' ? 'primary' : 'default'}}" data-type="delivery" bindtap="selectPickupType">门店配送</button></view>
    <view class="section"><view class="row">当前社区：{{selectedCommunity ? selectedCommunity.name : (community_id || '请选择社区')}}</view><button size="mini" bindtap="chooseCommunity">选择社区</button></view>
    <view class="section"><view class="row">自提点 / 发货点：{{selectedPickupStore ? selectedPickupStore.name : '请选择自提点'}}</view><view wx:if="{{selectedPickupStore}}" class="muted">自提点地址：{{selectedPickupStore.address}} {{selectedPickupStore.phone}}</view><button size="mini" bindtap="choosePickupStore">选择自提点</button><button wx:if="{{selectedPickupStore}}" size="mini" bindtap="copyPickupAddress">复制地址</button><button wx:if="{{selectedPickupStore}}" size="mini" bindtap="copyNavigationUrl">打开高德地图/复制导航链接</button></view>
    <block wx:if="{{pickup_type === 'delivery'}}"><view class="hint">{{deliveryRule.notice || '当前为门店配送，暂不接第三方配送。'}}</view><view class="hint">配送范围：{{deliveryRule.service_radius_text || '配送范围以门店确认为准'}}</view><view class="hint">配送费：¥{{deliveryRule.base_fee_yuan || '0.00'}}</view><view wx:if="{{deliveryRule.free_threshold_cents !== null}}" class="hint">免配送费门槛：¥{{deliveryRule.free_threshold_yuan}}</view><view class="row">配送时段</view><block wx:for="{{delivery_time_windows}}" wx:key="code"><button size="mini" type="{{delivery_time_window_code === item.code ? 'primary' : 'default'}}" data-code="{{item.code}}" bindtap="selectDeliveryTimeWindow">{{item.label}} {{item.start_time}}-{{item.end_time}}</button></block><input data-field="receiver_name" value="{{receiver_name}}" bindinput="onInput" placeholder="收货人姓名" /><input data-field="receiver_phone" value="{{receiver_phone}}" bindinput="onInput" placeholder="手机号" /><input data-field="receiver_address" value="{{receiver_address}}" bindinput="onInput" placeholder="收货地址" /></block>
    <block wx:else><view class="hint">到店自提：提交校验需要先选择自提点。</view></block>
    <view wx:if="{{submit_hint}}" class="hint">{{submit_hint}}</view><view wx:if="{{error}}" class="error">{{error}}</view>
    <button type="primary" loading="{{submitting}}" disabled="{{submitting || (product && product.stock <= 0)}}" bindtap="submit">{{submitting ? '提交中...' : '提交并 MOCK 支付'}}</button>
  </view>
</view>
