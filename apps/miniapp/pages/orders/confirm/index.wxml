<view class="page">
  <view class="panel">
    <view class="title">确认订单</view>
    <view wx:if="{{product}}" class="product">
      <view>{{product.name}}</view>
      <view>单价：¥{{product.price_yuan}}</view>
      <view class="muted">{{stock_label}}</view>
    </view>
    <view class="row">购买类型：{{type === 'group_buy' ? '开团购买' : '普通购买'}}</view>
    <view wx:if="{{from_cart}}" class="row muted">来自购物车</view>
    <view class="row">数量</view>
    <view class="quantity-box">
      <button size="mini" bindtap="decreaseQuantity" disabled="{{quantity <= 1}}">-</button>
      <input class="quantity-input" type="number" value="{{quantity}}" bindinput="onQuantityInput" placeholder="数量" />
      <button size="mini" bindtap="increaseQuantity" disabled="{{product && product.stock <= 0}}">+</button>
    </view>
    <view class="amounts">
      <view>购买数量：{{quantity}}</view>
      <view>商品小计：¥{{subtotal_yuan}}</view>
      <view class="pay">应付金额：¥{{pay_amount_yuan}}</view>
    </view>
    <view class="section">
      <view class="row">当前社区：{{selectedCommunity ? selectedCommunity.name : (community_id || '请选择社区')}}</view>
      <button size="mini" bindtap="chooseCommunity">选择社区</button>
    </view>
    <view class="section">
      <view class="row">当前自提点：{{selectedPickupStore ? selectedPickupStore.name : '请选择自提点'}}</view>
      <view wx:if="{{selectedPickupStore}}" class="muted">{{selectedPickupStore.address}} {{selectedPickupStore.phone}}</view>
      <button size="mini" bindtap="choosePickupStore">选择自提点</button>
    </view>
    <input data-field="receiver_name" value="{{receiver_name}}" bindinput="onInput" placeholder="收货人姓名" />
    <input data-field="receiver_phone" value="{{receiver_phone}}" bindinput="onInput" placeholder="手机号" />
    <view wx:if="{{submit_hint}}" class="hint">{{submit_hint}}</view>
    <view wx:if="{{error}}" class="error">{{error}}</view>
    <button type="primary" loading="{{submitting}}" disabled="{{submitting || (product && product.stock <= 0)}}" bindtap="submit">{{submitting ? '提交中...' : '提交并 MOCK 支付'}}</button>
  </view>
</view>
