<view class="page"><view class="panel"><view class="title">确认订单</view><view wx:if="{{product}}" class="product"><view>{{product.name}}</view><view>¥{{product.price_yuan}}</view></view><view class="row">购买类型：{{type === 'group_buy' ? '开团购买' : '普通购买'}}</view><view wx:if="{{from_cart}}" class="row muted">来自购物车</view><view class="row">数量</view><input data-field="quantity" type="number" value="{{quantity}}" bindinput="onInput" placeholder="数量"/><view class="section"><view class="row">已选社区：{{selectedCommunity ? selectedCommunity.name : (community_id || '未选择')}}</view><button size="mini" bindtap="chooseCommunity">选择社区</button></view><view class="section"><view class="row">已选自提点：{{selectedPickupStore ? selectedPickupStore.name : '未选择'}}</view><view wx:if="{{selectedPickupStore}}" class="muted">{{selectedPickupStore.address}} {{selectedPickupStore.phone}}</view><button size="mini" bindtap="choosePickupStore">选择自提点</button></view><input data-field="receiver_name" value="{{receiver_name}}" bindinput="onInput" placeholder="收货人姓名"/><input data-field="receiver_phone" value="{{receiver_phone}}" bindinput="onInput" placeholder="手机号"/><view wx:if="{{error}}" class="error">{{error}}</view><button type="primary" loading="{{submitting}}" bindtap="submit">提交并 MOCK 支付</button></view></view>
