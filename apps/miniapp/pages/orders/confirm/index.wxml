<view class="page"><view class="panel"><view class="title">确认订单</view><view class="row">类型：{{type === 'group_buy' ? '社区团购' : '普通购买'}}</view><input data-field="quantity" type="number" value="{{quantity}}" bindinput="onInput" placeholder="数量"/><input data-field="receiver_name" value="{{receiver_name}}" bindinput="onInput" placeholder="收货人"/><input data-field="receiver_phone" value="{{receiver_phone}}" bindinput="onInput" placeholder="手机号"/><input data-field="community_id" value="{{community_id}}" bindinput="onInput" placeholder="社区 ID（可选）"/><input data-field="pickup_store_id" value="{{pickup_store_id}}" bindinput="onInput" placeholder="自提点 ID（可选）"/><input data-field="receiver_address" value="{{receiver_address}}" bindinput="onInput" placeholder="配送地址（配送时填写）"/><button type="primary" loading="{{submitting}}" bindtap="submit">提交并 MOCK 支付</button></view></view>
