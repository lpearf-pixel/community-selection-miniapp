<view class="page">
  <view class="title">下单确认</view>
  <view class="meta">{{type === 'group_buy' ? '参与开团' : '立即购买'}}</view>
  <input type="number" placeholder="数量" value="{{quantity}}" bindinput="onInput" data-field="quantity" />
  <input placeholder="自提点 ID" value="{{pickup_store_id}}" bindinput="onInput" data-field="pickup_store_id" />
  <input placeholder="社区 ID" value="{{community_id}}" bindinput="onInput" data-field="community_id" />
  <input placeholder="收货人" value="{{receiver_name}}" bindinput="onInput" data-field="receiver_name" />
  <input placeholder="手机号" value="{{receiver_phone}}" bindinput="onInput" data-field="receiver_phone" />
  <input placeholder="配送地址（配送时填写）" value="{{receiver_address}}" bindinput="onInput" data-field="receiver_address" />
  <button type="primary" bindtap="submit">提交并支付</button>
</view>
