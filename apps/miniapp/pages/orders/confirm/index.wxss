.page { padding: 24rpx; background: #f7f8fa; min-height: 100vh; }
.panel { background: #fff; border-radius: 16rpx; padding: 24rpx; }
.title { font-size: 36rpx; font-weight: 600; margin-bottom: 20rpx; }
.product, .section, .amounts { padding: 18rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.row { margin: 12rpx 0; }
.muted, .hint { color: #888; font-size: 26rpx; }
.error { color: #d93026; margin: 16rpx 0; }
.quantity-box { display: flex; align-items: center; gap: 16rpx; margin: 12rpx 0; }
.quantity-input { width: 160rpx; text-align: center; border: 1rpx solid #ddd; border-radius: 8rpx; padding: 8rpx; }
.pay { font-weight: 600; color: #d93026; margin-top: 8rpx; }
