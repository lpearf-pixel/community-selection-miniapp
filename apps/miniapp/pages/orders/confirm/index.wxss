.page { padding: 24rpx; }
.title { font-size: 36rpx; font-weight: 600; margin-bottom: 20rpx; }
.card { padding: 24rpx; margin-bottom: 20rpx; background: #fff; border-radius: 16rpx; }
.name { font-size: 30rpx; font-weight: 600; }
.meta { color: #666; margin-top: 10rpx; }
.price { color: #ef4444; font-size: 34rpx; margin-top: 10rpx; }
.state { padding: 40rpx 0; text-align: center; color: #6b7280; }
.error { color: #dc2626; }
input { border: 1px solid #eee; border-radius: 12rpx; padding: 16rpx; margin-bottom: 16rpx; }
