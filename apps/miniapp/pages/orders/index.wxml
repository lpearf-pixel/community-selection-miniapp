<view class="cq-page page">
  <view class="cq-title page-title">我的订单</view>
  <scroll-view class="filter-scroll" scroll-x>
    <view class="filter-row">
      <view wx:for="{{statusTabs}}" wx:key="key" class="cq-chip filter-chip {{activeStatus === item.key ? 'cq-tone-brand' : 'cq-tone-neutral'}}" data-key="{{item.key}}" bindtap="switchStatus">{{item.label}}</view>
    </view>
  </scroll-view>
  <scroll-view class="filter-scroll type-filter" scroll-x>
    <view class="filter-row">
      <view wx:for="{{typeTabs}}" wx:key="key" class="cq-chip filter-chip {{activeType === item.key ? 'cq-tone-brand' : 'cq-tone-neutral'}}" data-key="{{item.key}}" bindtap="switchType">{{item.label}}</view>
    </view>
  </scroll-view>
  <state-panel wx:if="{{loading && orders.length === 0}}" state="loading" message="正在加载订单…" />
  <state-panel wx:elif="{{error}}" state="error" message="{{error}}" retryable bind:retry="loadOrders" />
  <state-panel wx:elif="{{orders.length === 0}}" state="empty" message="暂无订单" />
  <view wx:else class="order-list">
    <view wx:for="{{orders}}" wx:key="id" class="cq-card order-card">
      <view class="order-head">
        <text class="cq-muted">{{item.order_type_text}}</text>
        <status-pill text="{{item.user_status_text}}" tone="{{item.theme_status_tone}}" />
      </view>
      <view class="order-product" data-id="{{item.id}}" bindtap="goDetail">
        <view class="order-cover"><media-thumb src="{{item.product.cover_image}}" category-index="{{index}}" /></view>
        <view class="product-info">
          <view class="product-name">{{item.product.name}}</view>
          <view class="cq-muted product-meta">数量 x{{item.quantity}}</view>
          <view class="cq-price order-amount">¥{{item.amount_yuan}}</view>
        </view>
      </view>
      <view wx:if="{{item.pickup.pickup_store_name}}" class="cq-muted order-meta">自提点：{{item.pickup.pickup_store_name}}</view>
      <view wx:if="{{item.has_after_sale}}" class="cq-chip after-sale-chip">售后：{{item.after_sale_summary.latest_status || '处理中'}}</view>
      <view class="order-actions">
        <button class="cq-button cq-button--secondary" size="mini" data-id="{{item.id}}" bindtap="goDetail">查看详情</button>
        <button wx:if="{{item.can_show_pickup_code}}" class="cq-button cq-button--secondary" size="mini" data-id="{{item.id}}" bindtap="goPickupCode">自提凭证</button>
        <button wx:if="{{item.can_apply_after_sale}}" class="cq-button cq-button--secondary" size="mini" data-id="{{item.id}}" bindtap="applyAfterSale">申请售后</button>
        <button wx:if="{{item.has_after_sale}}" class="cq-button cq-button--secondary" size="mini" data-id="{{item.id}}" bindtap="goAfterSale">售后进度</button>
      </view>
    </view>
  </view>
  <view wx:if="{{loading && orders.length > 0}}" class="cq-state compact-state">加载更多…</view>
  <view wx:if="{{!hasMore && orders.length > 0}}" class="cq-state compact-state">没有更多了</view>
</view>
