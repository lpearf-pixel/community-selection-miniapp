.page { padding: 28rpx; }
.page-title { margin-bottom: 20rpx; }
.filter-scroll { width: 100%; margin-bottom: 14rpx; white-space: nowrap; }
.type-filter { margin-bottom: 22rpx; }
.filter-row { display: inline-flex; gap: 12rpx; }
.filter-chip { flex: none; }
.order-list { display: flex; flex-direction: column; gap: 18rpx; }
.order-card { padding: 22rpx; }
.order-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 18rpx; }
.order-product { display: flex; gap: 18rpx; }
.order-cover { width: 142rpx; height: 142rpx; overflow: hidden; flex: none; border-radius: var(--cq-radius-control); }
.product-info { min-width: 0; flex: 1; }
.product-name { font-size: 31rpx; font-weight: 700; }
.product-meta,
.order-meta { margin-top: 10rpx; font-size: 24rpx; }
.order-amount { margin-top: 12rpx; font-size: 31rpx; }
.after-sale-chip { margin-top: 14rpx; }
.order-actions { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 18rpx; }
.order-actions button { padding: 0 16rpx; font-size: 23rpx; }
.compact-state { padding: 28rpx; }
