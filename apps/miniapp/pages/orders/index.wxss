.page{padding:24rpx;background:#f6f7fb;min-height:100vh}.title{font-size:38rpx;font-weight:700;margin-bottom:20rpx}.tabs,.type-tabs{display:flex;gap:12rpx;overflow:auto;margin-bottom:16rpx}.tab,.type-tab{padding:12rpx 20rpx;border-radius:999rpx;background:#fff;color:#666;white-space:nowrap}.active{background:#1677ff;color:#fff}.card{background:#fff;border-radius:20rpx;padding:24rpx;margin-bottom:20rpx}.card-head{display:flex;justify-content:space-between;color:#666;margin-bottom:18rpx}.status{color:#1677ff}.product{display:flex;gap:18rpx}.cover{width:140rpx;height:140rpx;border-radius:16rpx;background:#edf0f5;text-align:center;line-height:140rpx;color:#999}.product-info{flex:1}.name{font-weight:600;font-size:32rpx}.meta,.pickup,.after-sale,.state{color:#666;margin-top:12rpx}.amount{color:#e5484d;font-weight:700;margin-top:12rpx}.actions{display:flex;gap:12rpx;flex-wrap:wrap;margin-top:20rpx}.error{color:#e5484d}.muted{color:#999;text-align:center}
