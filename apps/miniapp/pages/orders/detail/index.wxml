<view class="page">
  <view wx:if="{{loading}}" class="state">加载中...</view>
  <view wx:elif="{{error}}" class="state error">{{error}}</view>
  <block wx:elif="{{order}}">
    <view class="panel"><view class="title">订单详情</view><view>订单号：{{order.order_no || order.id}}</view><view>类型：{{order.order_type_text}}</view><view>履约方式：{{order.fulfillment_type_text}}</view><view>状态：{{order.user_status_text || order.order_status}}</view><view>数量：{{order.quantity}}</view><view>商品金额：¥{{order.product_amount_yuan}}</view><view>配送费：¥{{order.delivery_fee_yuan}}</view><view>实付金额：¥{{order.pay_amount_yuan}}</view></view>
    <view class="panel" wx:if="{{order.product}}"><view class="title">商品信息</view><image wx:if="{{order.product.cover_image}}" class="cover" src="{{order.product.cover_image}}" mode="aspectFill"/><view>{{order.product.name}}</view></view>
    <view class="panel" wx:if="{{order.pickup_type !== 'delivery'}}"><view class="title">到店自提</view><block wx:if="{{order.pickup && order.pickup.pickup_store_name}}"><view>自提点：{{order.pickup.pickup_store_name}}</view><view>自提点地址：{{order.pickup.pickup_store_address}}</view><view>自提点电话：{{order.pickup.pickup_store_phone}}</view><view>自提码：{{order.pickup.pickup_code}}</view></block><view wx:else>暂无自提点信息</view></view>
    <view class="panel" wx:if="{{order.pickup_type === 'delivery'}}"><view class="title">门店配送</view><view>配送地址：{{order.delivery.receiver_address || order.receiver.receiver_address}}</view><view>配送时段：{{order.delivery.delivery_time_window_text || order.delivery_time_window_text || '以门店确认时段为准'}}</view><view>配送费：¥{{order.delivery_fee_yuan}}</view><view>配送说明：{{order.delivery.notice || '当前为门店配送，暂不接第三方配送。'}}</view><view>配送范围：{{order.delivery.service_radius_text || order.service_radius_text}}</view><view>配送状态：{{order.delivery.delivery_status_text || order.delivery_status_text}}</view><view wx:if="{{order.pickup}}">发货点：{{order.pickup.pickup_store_name}}</view><view wx:if="{{order.pickup}}">自提点地址：{{order.pickup.pickup_store_address}}</view></view>
    <view class="panel"><view class="title">收货人</view><view>{{order.receiver.receiver_name}}</view><view>{{order.receiver_phone_masked}}</view></view>
    <view class="panel"><view class="title">售后摘要</view><view wx:if="{{order.has_after_sale}}">{{order.after_sale_summary.latest_status || '处理中'}}</view><view wx:else>暂无售后记录</view></view>
    <view class="panel" wx:if="{{order.timeline.length}}"><view class="title">订单时间线</view><block wx:for="{{order.timeline}}" wx:key="created_at"><view class="timeline">{{item.title || item.event_type}} · {{item.created_at}}</view></block></view>
    <view class="actions"><button wx:if="{{order.can_show_pickup_code}}" bindtap="goPickupCode">查看自提凭证</button><button wx:if="{{order.can_apply_after_sale}}" type="primary" bindtap="applyAfterSale">申请售后</button><button wx:if="{{order.has_after_sale}}" bindtap="goAfterSale">查看售后进度</button><button bindtap="backList">返回订单列表</button></view>
  </block>
</view>
