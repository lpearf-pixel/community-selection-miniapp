<view wx:if="{{order}}" class="page"><view class="panel"><view class="title">订单详情</view><view>订单号：{{order.id}}</view><view>状态：{{order.status}}</view><view>类型：{{order.order_type}}</view><view>金额：¥{{order.amount_yuan}}</view></view><view class="panel" wx:if="{{order.product}}"><view class="title">商品</view><view>{{order.product.name}}</view></view><view class="actions"><button bindtap="goPickupCode">查看自提凭证</button><button type="primary" bindtap="applyAfterSale">申请售后</button></view></view>
