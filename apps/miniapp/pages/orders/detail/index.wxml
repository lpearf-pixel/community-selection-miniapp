<view wx:if="{{order}}" class="page"><view class="panel"><view class="title">订单详情</view><view>订单号：{{order.order_no || order.id}}</view><view>状态：{{order.user_status_text || order.order_status}}</view><view>类型：{{order.order_type}}</view><view>金额：¥{{order.amount_yuan}}</view><view wx:if="{{order.community_name}}">社区：{{order.community_name}}</view><view>手机号：{{order.receiver_phone_masked}}</view></view><view class="panel" wx:if="{{order.product}}"><view class="title">商品</view><view>{{order.product.name}}</view></view><view class="panel"><view class="title">自提点</view><block wx:if="{{order.pickup && order.pickup.pickup_store_name}}"><view>{{order.pickup.pickup_store_name}}</view><view>{{order.pickup.pickup_store_address}}</view><view>{{order.pickup.pickup_store_phone}}</view></block><view wx:else>暂无自提点信息</view></view><view class="actions"><button bindtap="goPickupCode">查看自提凭证</button><button type="primary" bindtap="applyAfterSale">申请售后</button></view></view>
