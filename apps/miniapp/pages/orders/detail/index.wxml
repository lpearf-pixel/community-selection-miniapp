<view class="cq-page page">
  <state-panel wx:if="{{loading}}" state="loading" message="正在加载订单…" />
  <state-panel wx:elif="{{error}}" state="error" message="{{error}}" retryable bind:retry="retryOrder" />
  <block wx:elif="{{order}}">
    <view class="cq-card detail-card">
      <view class="detail-heading"><view class="cq-section-title">订单详情</view><status-pill text="{{order.user_status_text || order.order_status}}" tone="{{order.theme_status_tone}}" /></view>
      <view class="detail-grid">
        <view class="cq-muted">订单号</view><view>{{order.order_no || order.id}}</view>
        <view class="cq-muted">类型</view><view>{{order.order_type_text}}</view>
        <view class="cq-muted">履约方式</view><view>{{order.fulfillment_type_text}}</view>
        <view class="cq-muted">数量</view><view>{{order.quantity}}</view>
        <view class="cq-muted">商品金额</view><view>¥{{order.product_amount_yuan}}</view>
        <view class="cq-muted">配送费</view><view>¥{{order.delivery_fee_yuan}}</view>
        <view class="cq-muted">实付金额</view><view class="cq-price">¥{{order.pay_amount_yuan}}</view>
        <view class="cq-muted">已退商品金额</view><view>¥{{order.product_refund_yuan}}</view>
        <view class="cq-muted">已退配送费</view><view>¥{{order.delivery_refund_yuan}}</view>
        <view class="cq-muted">剩余可退</view><view class="cq-price">¥{{order.remaining_refundable_yuan}}</view>
      </view>
    </view>
    <view class="cq-card detail-card product-card" wx:if="{{order.product}}">
      <view class="product-cover"><media-thumb src="{{order.product.cover_image}}" /></view>
      <view class="product-copy"><view class="cq-section-title">商品信息</view><view class="product-name">{{order.product.name}}</view></view>
    </view>
    <view class="cq-card detail-card" wx:if="{{order.pickup_type !== 'delivery'}}">
      <view class="cq-section-title card-title">到店自提</view>
      <view wx:if="{{order.pickup && order.pickup.pickup_store_name}}" class="detail-lines">
        <view>自提点：{{order.pickup.pickup_store_name}}</view><view>地址：{{order.pickup.pickup_store_address}}</view><view>电话：{{order.pickup.pickup_store_phone}}</view><view>自提码：{{order.pickup.pickup_code}}</view>
      </view>
      <view wx:else class="cq-muted">暂无自提点信息</view>
    </view>
    <view class="cq-card detail-card" wx:if="{{order.pickup_type === 'delivery'}}">
      <view class="cq-section-title card-title">门店配送</view>
      <view class="detail-lines"><view>配送地址：{{order.delivery.receiver_address || order.receiver.receiver_address}}</view><view>配送时段：{{order.delivery.delivery_time_window_text || order.delivery_time_window_text || '以门店确认时段为准'}}</view><view>配送费：¥{{order.delivery_fee_yuan}}</view><view class="cq-muted">{{order.delivery.notice || '当前为门店配送，暂不接第三方配送。'}}</view><view>配送范围：{{order.delivery.service_radius_text || order.service_radius_text}}</view><view>配送状态：{{order.delivery.delivery_status_text || order.delivery_status_text}}</view><view wx:if="{{order.pickup}}">发货点：{{order.pickup.pickup_store_name}}</view></view>
    </view>
    <view class="cq-card detail-card"><view class="cq-section-title card-title">收货人</view><view>{{order.receiver.receiver_name}}</view><view class="cq-muted">{{order.receiver_phone_masked}}</view></view>
    <view class="cq-card detail-card"><view class="cq-section-title card-title">售后摘要</view><view wx:if="{{order.has_after_sale}}">{{order.after_sale_summary.latest_status || '处理中'}}</view><view wx:else class="cq-muted">暂无售后记录</view></view>
    <view class="cq-card detail-card" wx:if="{{order.timeline.length}}"><view class="cq-section-title card-title">订单时间线</view><view wx:for="{{order.timeline}}" wx:key="created_at" class="cq-muted timeline-row">{{item.title || item.event_type}} · {{item.created_at}}</view></view>
    <view class="cq-card detail-card detail-actions">
      <button wx:if="{{order.can_show_pickup_code}}" class="cq-button cq-button--secondary" bindtap="goPickupCode">查看自提凭证</button>
      <button wx:if="{{order.can_apply_after_sale}}" class="cq-button cq-button--primary" data-testid="after-sale-apply" bindtap="applyAfterSale">申请售后</button>
      <button wx:if="{{order.has_after_sale}}" class="cq-button cq-button--secondary" bindtap="goAfterSale">查看售后进度</button>
      <button class="cq-button cq-button--secondary" bindtap="backList">返回订单列表</button>
    </view>
  </block>
</view>
