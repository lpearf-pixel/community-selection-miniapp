.page { padding: 28rpx; }
.page-title { margin-bottom: 22rpx; }
.after-sale-list { display: flex; flex-direction: column; gap: 18rpx; }
.after-sale-card { padding: 24rpx; }
.case-head { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; margin-bottom: 18rpx; }
.case-type { font-size: 31rpx; font-weight: 700; }
.case-row { display: grid; grid-template-columns: 170rpx 1fr; gap: 16rpx; margin-top: 12rpx; line-height: 1.5; }
.back-card { margin-top: 20rpx; padding: 18rpx; }
.back-card button { width: 100%; }
