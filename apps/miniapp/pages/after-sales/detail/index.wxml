<view class="page"><view class="title">售后进度</view><view wx:if="{{loading}}" class="state">加载中...</view><view wx:elif="{{error}}" class="state error">{{error}}</view><view wx:elif="{{items.length === 0}}" class="state">暂无售后记录</view><block wx:else wx:for="{{items}}" wx:key="after_sale_case_id"><view class="card"><view>类型：{{item.type}}</view><view>状态：{{item.status}}</view><view>原因：{{item.reason}}</view><view wx:if="{{item.description}}">说明：{{item.description}}</view><view>申请金额：¥{{item.refund_yuan}}</view><view>提交时间：{{item.created_at}}</view></view></block><button bindtap="backOrder">返回订单详情</button></view>
