<view class="cq-page page">
  <view class="cq-title page-title">售后进度</view>
  <state-panel wx:if="{{loading}}" state="loading" message="正在加载售后记录…" />
  <state-panel wx:elif="{{error}}" state="error" message="{{error}}" retryable bind:retry="retryList" />
  <state-panel wx:elif="{{items.length === 0}}" state="empty" message="暂无售后记录" />
  <view wx:else class="after-sale-list">
    <view wx:for="{{items}}" wx:key="after_sale_case_id" class="cq-card after-sale-card">
      <view class="case-head"><view class="case-type">{{item.type}}</view><status-pill text="{{item.status}}" tone="{{item.theme_status_tone}}" /></view>
      <view class="case-row"><text class="cq-muted">原因</text><text>{{item.reason}}</text></view>
      <view wx:if="{{item.description}}" class="case-row"><text class="cq-muted">说明</text><text>{{item.description}}</text></view>
      <view class="case-row"><text class="cq-muted">申请金额</text><text class="cq-price">¥{{item.refund_yuan}}</text></view>
      <view class="case-row"><text class="cq-muted">商品退款</text><text>¥{{item.product_refund_yuan}}</text></view>
      <view class="case-row"><text class="cq-muted">配送费退款</text><text>¥{{item.delivery_refund_yuan}}</text></view>
      <view class="case-row"><text class="cq-muted">提交时间</text><text>{{item.created_at}}</text></view>
    </view>
  </view>
  <view class="cq-card back-card"><button class="cq-button cq-button--secondary" bindtap="backOrder">返回订单详情</button></view>
</view>
