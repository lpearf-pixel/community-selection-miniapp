.page { padding: 24rpx; }
.title { font-size: 36rpx; font-weight: 700; margin-bottom: 20rpx; }
.state { padding: 20rpx 0; color: #6b7280; }
.error { color: #dc2626; }
.picker, input, textarea { border: 1px solid #eee; border-radius: 12rpx; padding: 16rpx; margin-bottom: 16rpx; }
textarea { width: auto; min-height: 160rpx; }
