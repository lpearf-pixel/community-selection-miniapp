<view class="page"><view class="title">申请售后</view><view wx:if="{{error}}" class="error">{{error}}</view><view class="form"><view class="label">售后类型</view><picker range="{{types}}" range-key="label" value="{{typeIndex}}" bindchange="onTypeChange"><view class="picker">{{types[typeIndex].label}}</view></picker><view class="label">售后原因</view><textarea data-field="reason" value="{{reason}}" bindinput="onInput" placeholder="请描述遇到的问题"/><view class="label">补充说明</view><textarea data-field="description" value="{{description}}" bindinput="onInput" placeholder="可选"/><view class="label">本次申请退款</view><view class="picker">¥{{refund_amount_yuan}}</view><view class="label">申请金额按订单当前剩余可退金额确定，最终退款金额以平台审核结果为准</view><button type="primary" loading="{{submitting}}" disabled="{{!can_submit || submitting || loading}}" bindtap="submit">提交售后申请</button></view></view>
