<view class="page"><view class="title">申请售后</view><view wx:if="{{error}}" class="error">{{error}}</view><view class="form"><view class="label">售后类型</view><picker range="{{types}}" range-key="label" value="{{typeIndex}}" bindchange="onTypeChange"><view class="picker">{{types[typeIndex].label}}</view></picker><view class="label">售后原因</view><textarea data-field="reason" value="{{reason}}" bindinput="onInput" placeholder="请描述遇到的问题"/><view class="label">补充说明</view><textarea data-field="description" value="{{description}}" bindinput="onInput" placeholder="可选"/><view class="label">申请金额（分）</view><input type="number" data-field="requested_refund_cents" value="{{requested_refund_cents}}" bindinput="onInput" placeholder="默认可填订单金额"/><button type="primary" loading="{{submitting}}" bindtap="submit">提交售后申请</button></view></view>
