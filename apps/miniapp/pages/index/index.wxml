<view class="home-page {{layout.pageClass}}">
  <block wx:for="{{layout.sections}}" wx:key="type" wx:for-item="section">
    <brand-hero
      wx:if="{{section.type === 'brandHero'}}"
      brand="{{layout.brand}}"
      services="{{layout.services}}"
      variant="{{section.variant}}"
    />
    <category-grid
      wx:elif="{{section.type === 'categoryGrid'}}"
      categories="{{layout.categories}}"
      variant="{{section.variant}}"
      bind:navigate="onNavigate"
    />
    <product-showcase
      wx:elif="{{section.type === 'productShowcase'}}"
      title="{{layout.sectionTitles.products}}"
      hint="{{layout.sectionTitles.productsHint}}"
      items="{{products}}"
      loading="{{productsLoading}}"
      error="{{productsError}}"
      variant="{{section.variant}}"
      bind:navigate="onNavigate"
      bind:retry="onRetry"
    />
    <group-buy-showcase
      wx:elif="{{section.type === 'groupBuyShowcase'}}"
      title="{{layout.sectionTitles.groupBuys}}"
      hint="{{layout.sectionTitles.groupBuysHint}}"
      items="{{groupBuys}}"
      loading="{{groupBuysLoading}}"
      error="{{groupBuysError}}"
      variant="{{section.variant}}"
      bind:navigate="onNavigate"
      bind:retry="onRetry"
    />
    <quick-actions
      wx:elif="{{section.type === 'quickActions'}}"
      variant="{{section.variant}}"
      bind:navigate="onNavigate"
    />
  </block>
</view>
