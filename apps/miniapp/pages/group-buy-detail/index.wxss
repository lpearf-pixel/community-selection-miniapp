.page { padding-bottom: 150rpx; }
.group-hero { width: 100%; height: 380rpx; overflow: hidden; }
.group-panel { margin: 24rpx 28rpx; padding: 28rpx; }
.group-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; }
.group-name { min-width: 0; flex: 1; font-size: 38rpx; font-weight: 700; }
.group-price { margin: 18rpx 0 24rpx; font-size: 42rpx; }
.group-progress { display: grid; grid-template-columns: 220rpx 1fr; gap: 16rpx 20rpx; line-height: 1.5; }
.process-tip { margin-top: 24rpx; }
.group-actions button { flex: 1; }
