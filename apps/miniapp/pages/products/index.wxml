<view class="page"><view class="top"><view class="location" bindtap="chooseCommunity">{{selectedCommunity ? selectedCommunity.name : '请选择社区'}}</view><button size="mini" bindtap="goCart">购物车 {{cartCount}}</button></view><view class="search"><input placeholder="搜索社区好物" value="{{keyword}}" bindinput="onKeywordInput"/><button bindtap="onSearch">搜索</button></view><view wx:if="{{!products.length && !loading}}" class="empty">暂无可购商品</view><view wx:for="{{products}}" wx:key="product_id" class="card" bindtap="goDetail" data-id="{{item.product_id}}"><image wx:if="{{item.cover_image}}" src="{{item.cover_image}}" mode="aspectFill" class="cover" /><view class="info"><view class="name">{{item.name}}</view><view class="price">¥{{item.price_yuan}}</view><view class="meta">{{item.stock_label}}</view><view wx:if="{{item.has_active_group_buy}}" class="tag">可参与社区团购</view></view><view class="actions"><button size="mini" catchtap="addCart" data-id="{{item.product_id}}" disabled="{{item.stock <= 0}}">加入购物车</button><button size="mini" catchtap="goNormalBuy" data-id="{{item.product_id}}" disabled="{{item.stock <= 0}}">直接下单</button></view></view></view>
