<view class="page">
  <view class="section-title">商品列表</view>
  <view wx:if="{{loading}}" class="state">加载中...</view>
  <view wx:elif="{{error}}" class="state error">{{error}}</view>
  <view wx:elif="{{empty}}" class="state">暂无商品</view>
  <block wx:else>
    <block wx:for="{{products}}" wx:key="product_id">
      <view class="product">
        <image class="cover" src="{{item.cover_image}}" mode="aspectFill" bindtap="goDetail" data-id="{{item.product_id}}" />
        <view class="info">
          <view class="name" bindtap="goDetail" data-id="{{item.product_id}}">{{item.name}}</view>
          <view class="price">¥{{item.price_yuan}}</view>
          <view class="meta">{{item.sale_text}} · 库存 {{item.display_stock}}</view>
          <view class="meta">{{item.has_active_group_buy ? '有可参与开团' : '暂无可参与开团'}}</view>
          <view class="actions">
            <button size="mini" type="primary" bindtap="goNormalBuy" data-id="{{item.product_id}}">立即购买</button>
            <button size="mini" bindtap="goDetail" data-id="{{item.product_id}}">查看详情</button>
          </view>
        </view>
      </view>
    </block>
  </block>
</view>
