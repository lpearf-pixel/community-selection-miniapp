<view class="page">
  <view class="section-title">商品列表</view>
  <block wx:for="{{products}}" wx:key="id">
    <view class="product" bindtap="goDetail" data-id="{{item.id}}">
      <image class="cover" src="{{item.cover_image}}" mode="aspectFill" />
      <view class="info">
        <view class="name">{{item.name}}</view>
        <view class="price">¥{{item.price_yuan}}</view>
        <view class="meta">库存 {{item.stock}}{{item.unit}} · {{item.is_group_enabled ? '支持开团' : '普通商品'}}</view>
      </view>
    </view>
  </block>
</view>
