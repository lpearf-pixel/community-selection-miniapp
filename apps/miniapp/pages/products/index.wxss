.page{padding:24rpx;background:#f7f8fa;min-height:100vh}.search{display:flex;gap:16rpx;margin-bottom:20rpx}.search input{flex:1;background:#fff;border-radius:12rpx;padding:0 20rpx}.card{display:flex;gap:20rpx;background:#fff;border-radius:18rpx;padding:20rpx;margin-bottom:18rpx}.cover{width:160rpx;height:160rpx;border-radius:14rpx;background:#eee}.info{flex:1}.name{font-weight:600;color:#222}.price{color:#f5222d;font-size:36rpx;margin:12rpx 0}.meta{color:#666;font-size:24rpx}.tag{display:inline-block;margin-top:12rpx;color:#1677ff;background:#e6f4ff;border-radius:999rpx;padding:4rpx 14rpx;font-size:22rpx}.empty{text-align:center;color:#999;padding:80rpx 0}button{align-self:center}
