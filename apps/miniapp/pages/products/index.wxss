.page {
  padding: 24rpx;
}
.section-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}
.product {
  display: flex;
  gap: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  background: #ffffff;
  border-radius: 16rpx;
}
.cover {
  width: 144rpx;
  height: 144rpx;
  background: #eef2f7;
  border-radius: 12rpx;
}
.info {
  flex: 1;
}
.name {
  font-size: 30rpx;
  font-weight: 600;
}
.price {
  color: #ef4444;
  font-size: 32rpx;
  margin: 12rpx 0;
}
.meta {
  color: #6b7280;
  font-size: 24rpx;
}
