<view class="page">
  <view class="title">今日开团</view>
  <block wx:for="{{groupBuys}}" wx:key="id">
    <view class="card" bindtap="openDetail" data-id="{{item.id}}">
      <view class="name">{{item.product.name}}</view>
      <view class="meta">{{item.community.name}} · {{item.current_people}}/{{item.min_people}} 人</view>
      <view class="price">¥{{item.price_cents / 100}}</view>
    </view>
  </block>
</view>
