.page { padding: 28rpx; }
.page-title { margin-bottom: 24rpx; }
.group-list { display: flex; flex-direction: column; gap: 18rpx; }
.group-card { display: flex; overflow: hidden; }
.group-cover { width: 200rpx; min-height: 200rpx; flex: none; }
.group-body { min-width: 0; flex: 1; padding: 22rpx; }
.group-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12rpx; }
.group-name { min-width: 0; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 32rpx; font-weight: 700; }
.group-meta { margin-top: 16rpx; font-size: 24rpx; }
.group-price { margin-top: 14rpx; font-size: 34rpx; }
