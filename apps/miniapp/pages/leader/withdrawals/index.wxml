<view class="page">
  <view class="notice">{{notice}}</view>
  <view class="card">可提现开团服务奖励：¥{{balance / 100}}</view>
  <view class="section-title">选择整笔奖励</view>
  <block wx:for="{{items}}" wx:key="commission_id">
    <view class="row" bindtap="toggle" data-id="{{item.commission_id}}">
      <checkbox checked="{{selected[item.commission_id]}}" />
      <view class="info"><view>{{item.product_name}} / {{item.order_no}}</view><view class="muted">{{item.community_name}} ¥{{item.final_amount_cents / 100}}</view></view>
    </view>
  </block>
  <button loading="{{submitting}}" disabled="{{submitting || selectedTotal <= 0}}" bindtap="submit">提交人工审核（¥{{selectedTotal / 100}}）</button>
  <view class="section-title">提现记录</view>
  <block wx:for="{{withdrawals}}" wx:key="withdrawal_id"><view class="record">¥{{item.amount_cents / 100}} - {{item.status_text}}<view class="muted">{{item.created_at}}</view></view></block>
</view>
