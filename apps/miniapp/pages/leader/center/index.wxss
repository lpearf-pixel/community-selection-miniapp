.page { padding: 28rpx; }
.page-title { margin-bottom: 22rpx; }
.access-card { padding: 20rpx; }
.access-card button { width: 260rpx; margin: 0 auto 14rpx; }
.notice-card { margin-bottom: 20rpx; padding: 22rpx; line-height: 1.6; }
.refresh-warning { display: flex; justify-content: space-between; margin-bottom: 20rpx; padding: 18rpx 22rpx; }
.retry-link { margin-left: 18rpx; font-weight: 700; }
.section-title { margin: 28rpx 0 14rpx; }
.metric-grid,
.reward-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12rpx; padding: 22rpx 12rpx; }
.metric-item,
.reward-item { min-width: 0; text-align: center; }
.metric-value { margin-bottom: 6rpx; font-size: 36rpx; }
.reward-value { margin-bottom: 8rpx; font-size: 27rpx; font-weight: 700; }
.metric-label { font-size: 22rpx; }
.withdraw-button { width: 100%; margin-top: 20rpx; }
.withdrawal-card { padding: 20rpx 24rpx; }
.withdrawal-row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; padding: 18rpx 0; }
.withdrawal-amount { font-size: 30rpx; }
.withdrawal-time { margin-top: 6rpx; font-size: 23rpx; }
.status-summary { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16rpx; margin-top: 18rpx; padding: 22rpx; font-size: 24rpx; }
