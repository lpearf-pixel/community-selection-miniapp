.page{min-height:100vh;padding:24rpx;background:#f5f7fb;box-sizing:border-box}.page-title{margin-bottom:20rpx;font-size:40rpx;font-weight:700}.card,.state-card{margin-bottom:20rpx;padding:24rpx;background:#fff;border-radius:20rpx;box-sizing:border-box}.state-card{text-align:center}.state-title{margin-bottom:10rpx;font-size:32rpx;font-weight:700}.forbidden-state{color:#8c8c8c}.error-state{color:#b42318}.notice{margin-bottom:20rpx;padding:20rpx;color:#ad6800;background:#fff7e6;border-radius:16rpx;line-height:1.6}.refresh-warning{display:flex;justify-content:space-between;margin-bottom:20rpx;padding:18rpx 22rpx;color:#ad6800;background:#fff7e6;border-radius:14rpx}.retry-link{font-weight:600}.section-title{margin:28rpx 0 14rpx;font-size:30rpx;font-weight:700}.metric-grid,.reward-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12rpx}.metric-item,.reward-item{text-align:center}.metric-value{margin-bottom:6rpx;font-size:36rpx;font-weight:700;color:#1677ff}.reward-value{margin-bottom:8rpx;font-size:28rpx;font-weight:700}.reward-value.primary{color:#1677ff}.muted{color:#7a8495;font-size:24rpx}.withdraw-button{margin:20rpx 0}.withdrawal-row{display:flex;align-items:center;justify-content:space-between;padding:18rpx 0;border-bottom:1rpx solid #f0f0f0}.withdrawal-row:last-child{border-bottom:none}.withdrawal-amount{font-size:30rpx;font-weight:700}.status-text{color:#1677ff;font-size:24rpx}.empty-text{text-align:center;color:#999}.status-summary{display:grid;grid-template-columns:repeat(2,1fr);gap:16rpx;color:#606b7b;font-size:24rpx}