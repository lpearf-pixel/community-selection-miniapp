.page { padding: 28rpx; }
.page-title { margin-bottom: 22rpx; }
.profile-card { display: flex; align-items: center; gap: 20rpx; margin-bottom: 20rpx; padding: 24rpx; }
.avatar { width: 98rpx; height: 98rpx; flex: none; border-radius: 50%; }
.avatar-placeholder { display: flex; align-items: center; justify-content: center; font-size: 36rpx; }
.profile-copy { min-width: 0; flex: 1; }
.profile-name { margin-bottom: 7rpx; font-size: 34rpx; font-weight: 700; }
.refresh-warning { display: flex; justify-content: space-between; margin-bottom: 20rpx; padding: 18rpx 22rpx; line-height: 1.5; }
.retry-link { margin-left: 18rpx; font-weight: 700; }
.section-title { margin: 28rpx 0 14rpx; }
.metric-grid { display: grid; grid-template-columns: repeat(5, 1fr); padding: 20rpx 10rpx; }
.metric-item { text-align: center; }
.metric-value { margin-bottom: 6rpx; font-size: 34rpx; }
.metric-label { font-size: 21rpx; }
.action-row,
.leader-entry { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; margin-bottom: 18rpx; padding: 24rpx; }
.action-title { font-size: 30rpx; font-weight: 700; }
.action-hint { margin-top: 7rpx; font-size: 24rpx; }
.arrow { font-size: 48rpx; }
.service-actions { display: flex; flex-direction: column; gap: 14rpx; padding: 20rpx; }
.service-actions button { width: 100%; justify-content: flex-start; padding: 0 20rpx; text-align: left; font-size: 26rpx; }
