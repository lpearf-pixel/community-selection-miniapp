<view class="page">
  <view class="title">自提凭证</view>
  <view wx:if="{{loading}}" class="state">加载中...</view>
  <view wx:elif="{{error}}" class="state error">{{error}}</view>
  <view wx:elif="{{code}}" class="card">
    <view class="code">{{code.pickup_code}}</view>
    <view>订单号：{{code.order_no}}</view>
    <view>自提点：{{code.pickup_store_name}}</view>
    <view>地址：{{code.pickup_store_address}}</view>
    <view>电话：{{code.pickup_store_phone}}</view>
    <view>收货人：{{code.receiver_name}}</view>
    <view>手机号：{{code.receiver_phone_masked}}</view>
  </view>
</view>
