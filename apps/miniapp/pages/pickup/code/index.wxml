<view class="page">
  <view class="title">自提凭证</view>
  <view wx:if="{{loading}}" class="state">加载中...</view>
  <view wx:elif="{{error}}" class="state error">{{error}}</view>
  <view wx:elif="{{empty || !pickup}}" class="state">暂无自提凭证</view>
  <view wx:else class="card">
    <view class="code">{{pickup.pickup_code}}</view>
    <view class="row">订单号：{{pickup.order_no}}</view>
    <view class="row">自提点：{{pickup.pickup_store_name}}</view>
    <view class="row">地址：{{pickup.pickup_store_address}}</view>
    <view class="row">电话：{{pickup.pickup_store_phone}}</view>
    <view class="row">收货人：{{pickup.receiver_name}}</view>
    <view class="row">手机号：{{pickup.receiver_phone_masked}}</view>
  </view>
</view>
