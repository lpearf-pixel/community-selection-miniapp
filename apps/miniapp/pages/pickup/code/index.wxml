<view class="cq-page page">
  <view class="cq-title page-title">自提凭证</view>
  <state-panel wx:if="{{loading}}" state="loading" message="正在加载自提凭证…" />
  <state-panel wx:elif="{{error}}" state="error" message="{{error}}" />
  <view wx:elif="{{code}}" class="cq-card pickup-card">
    <status-pill text="请向门店出示此凭证" tone="success" />
    <view class="pickup-code">{{code.pickup_code}}</view>
    <view class="pickup-grid">
      <view class="cq-muted">订单号</view><view>{{code.order_no}}</view>
      <view class="cq-muted">自提点</view><view>{{code.pickup_store_name}}</view>
      <view class="cq-muted">地址</view><view>{{code.pickup_store_address}}</view>
      <view class="cq-muted">电话</view><view>{{code.pickup_store_phone}}</view>
      <view class="cq-muted">收货人</view><view>{{code.receiver_name}}</view>
      <view class="cq-muted">手机号</view><view>{{code.receiver_phone_masked}}</view>
    </view>
  </view>
  <state-panel wx:else state="empty" message="暂无可用自提凭证" />
</view>
