<view class="cq-page page">
  <view class="cq-title page-title">选择自提点</view>
  <view wx:if="{{community}}" class="cq-chip current-community">当前社区：{{community.name}}</view>
  <view class="search">
    <input class="cq-input search-input" placeholder="搜索自提点名称或地址" value="{{keyword}}" bindinput="onInput"/>
    <button class="cq-button cq-button--primary search-button" bindtap="onSearch">搜索</button>
  </view>
  <state-panel wx:if="{{loading}}" state="loading" message="正在加载自提点…" />
  <state-panel wx:elif="{{error}}" state="error" message="{{error}}" retryable bind:retry="load" />
  <state-panel wx:elif="{{items.length === 0}}" state="empty" message="暂无自提点" />
  <view wx:else class="pickup-list">
    <view wx:for="{{items}}" wx:key="pickup_store_id" class="cq-card pickup-card" data-id="{{item.pickup_store_id}}" bindtap="select">
      <view class="pickup-name">{{item.name}}</view>
      <view class="cq-muted pickup-meta">{{item.address}}</view>
      <view class="cq-muted pickup-meta">{{item.phone}}</view>
    </view>
  </view>
</view>
