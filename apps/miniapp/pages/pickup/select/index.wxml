<view class="page"><view class="title">选择自提点</view><view wx:if="{{community}}" class="hint">当前社区：{{community.name}}</view><view class="search"><input placeholder="搜索自提点名称或地址" value="{{keyword}}" bindinput="onInput"/><button bindtap="onSearch">搜索</button></view><view wx:if="{{loading}}">加载中...</view><view wx:elif="{{error}}" class="error">{{error}}</view><view wx:elif="{{items.length === 0}}" class="empty">暂无自提点</view><block wx:else><view wx:for="{{items}}" wx:key="pickup_store_id" class="card" data-id="{{item.pickup_store_id}}" bindtap="select"><view class="name">{{item.name}}</view><view class="address">{{item.address}}</view><view class="phone">{{item.phone}}</view></view></block></view>
