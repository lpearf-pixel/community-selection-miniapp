<view class="cq-page page">
  <view class="cq-title page-title">选择社区</view>
  <view class="search">
    <input class="cq-input search-input" placeholder="搜索社区名称或地址" value="{{keyword}}" bindinput="onInput"/>
    <button class="cq-button cq-button--primary search-button" bindtap="onSearch">搜索</button>
  </view>
  <state-panel wx:if="{{loading}}" state="loading" message="正在加载社区…" />
  <state-panel wx:elif="{{error}}" state="error" message="{{error}}" retryable bind:retry="load" />
  <state-panel wx:elif="{{items.length === 0}}" state="empty" message="暂无社区" />
  <view wx:else class="community-list">
    <view wx:for="{{items}}" wx:key="community_id" class="cq-card community-card" data-id="{{item.community_id}}" bindtap="select">
      <view class="community-name">{{item.name}}</view>
      <view class="cq-muted community-address">{{item.address}}</view>
    </view>
  </view>
</view>
