<view class="page"><view class="title">选择社区</view><view class="search"><input placeholder="搜索社区名称或地址" value="{{keyword}}" bindinput="onInput"/><button bindtap="onSearch">搜索</button></view><view wx:if="{{loading}}">加载中...</view><view wx:elif="{{error}}" class="error">{{error}}</view><view wx:elif="{{items.length === 0}}" class="empty">暂无社区</view><block wx:else><view wx:for="{{items}}" wx:key="community_id" class="card" data-id="{{item.community_id}}" bindtap="select"><view class="name">{{item.name}}</view><view class="address">{{item.address}}</view></view></block></view>
