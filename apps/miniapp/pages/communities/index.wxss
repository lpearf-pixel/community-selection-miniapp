.page { padding: 28rpx; }
.page-title { margin-bottom: 24rpx; }
.search { display: flex; gap: 14rpx; margin-bottom: 24rpx; }
.search-input { flex: 1; height: 76rpx; padding: 0 20rpx; }
.search-button { width: 156rpx; height: 76rpx; font-size: 28rpx; }
.community-list { display: flex; flex-direction: column; gap: 18rpx; }
.community-card { padding: 24rpx; }
.community-name { font-size: 31rpx; font-weight: 700; }
.community-address { margin-top: 10rpx; font-size: 25rpx; line-height: 1.5; }
