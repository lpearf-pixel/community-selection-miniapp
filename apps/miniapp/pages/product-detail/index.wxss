.page {
  padding-bottom: 32rpx;
}
.cover {
  width: 100%;
  height: 420rpx;
  background: #eef2f7;
}
.card {
  margin: 24rpx;
  padding: 28rpx;
  background: #ffffff;
  border-radius: 16rpx;
}
.name {
  font-size: 36rpx;
  font-weight: 700;
}
.price {
  color: #ef4444;
  font-size: 38rpx;
  margin: 18rpx 0;
}
.meta,
.description {
  color: #4b5563;
  font-size: 26rpx;
  margin-top: 12rpx;
}
