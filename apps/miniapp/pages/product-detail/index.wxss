.page{background:#f7f8fa;min-height:100vh;padding-bottom:120rpx}.hero{width:100%;height:420rpx;background:#eee}.panel{background:#fff;margin:20rpx;padding:24rpx;border-radius:18rpx}.name{font-size:36rpx;font-weight:700}.price{color:#f5222d;font-weight:600;margin:12rpx 0}.desc{color:#666;line-height:1.6}.section-title{font-weight:700;margin-bottom:16rpx}.group{display:flex;align-items:center;justify-content:space-between;border-top:1rpx solid #eee;padding:18rpx 0}.empty{color:#999}.footer{position:fixed;left:0;right:0;bottom:0;background:#fff;padding:20rpx 24rpx;box-shadow:0 -4rpx 20rpx rgba(0,0,0,.06)}
