.page { padding-bottom: 150rpx; }
.product-hero { width: 100%; height: 430rpx; overflow: hidden; }
.product-panel,
.group-panel { margin: 22rpx 28rpx; padding: 26rpx; }
.product-name { font-size: 38rpx; font-weight: 700; }
.product-price { margin: 14rpx 0; font-size: 40rpx; }
.product-meta { font-size: 25rpx; }
.product-description { margin-top: 20rpx; line-height: 1.7; }
.group-title { margin-bottom: 12rpx; }
.group-row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 20rpx 0; }
.group-copy { min-width: 0; flex: 1; }
.group-price { margin-top: 8rpx; }
.group-button { width: 128rpx; flex: none; }
.product-actions button { min-width: 0; flex: 1; padding: 0 12rpx; font-size: 25rpx; }
