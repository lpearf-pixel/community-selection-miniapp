<view class="page">
  <view wx:if="{{loading}}" class="state">加载中...</view>
  <view wx:elif="{{error}}" class="state error">{{error}}</view>
  <view wx:elif="{{empty || !product}}" class="state">暂无商品详情</view>
  <block wx:else>
    <image class="cover" src="{{product.cover_image}}" mode="aspectFill" />
    <view class="card">
      <view class="name">{{product.name}}</view>
      <view class="price">¥{{product.price_yuan}}</view>
      <view class="meta">{{product.sale_text}} · 库存 {{product.display_stock}}</view>
      <view class="description">{{product.description}}</view>
      <button type="primary" bindtap="goNormalBuy" disabled="{{!product.can_normal_buy}}">立即购买</button>
    </view>

    <view class="card">
      <view class="section-title">可参与开团</view>
      <block wx:if="{{product.active_group_buys.length}}">
        <block wx:for="{{product.active_group_buys}}" wx:key="group_buy_id">
          <view class="group-buy">
            <view>{{item.community_name}} · {{item.leader_nickname}}</view>
            <view class="meta">{{item.current_people}}/{{item.min_people}} 人 · ¥{{item.price_yuan}}</view>
            <button size="mini" type="primary" bindtap="goGroupBuy" data-id="{{item.group_buy_id}}">参与开团</button>
          </view>
        </block>
      </block>
      <view wx:else class="meta">当前暂无可参与开团</view>
    </view>
  </block>
</view>
