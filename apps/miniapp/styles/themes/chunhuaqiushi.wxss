.theme-chunhuaqiushi { color: #2D3A31; }
.theme-chunhuaqiushi .brand-hero { background: #FFFDF8; }
.theme-chunhuaqiushi .brand-name { color: #315B45; }
.theme-chunhuaqiushi .brand-subtitle,
.theme-chunhuaqiushi .section-hint,
.theme-chunhuaqiushi .product-stock,
.theme-chunhuaqiushi .group-community,
.theme-chunhuaqiushi .quick-desc { color: #748078; }
.theme-chunhuaqiushi .brand-slogan { color: #315B45; }
.theme-chunhuaqiushi .brand-season { color: #5E725F; }
.theme-chunhuaqiushi .category-tile { color: #315B45; background: rgba(255, 253, 248, 0.88); border: 1rpx solid rgba(49, 91, 69, 0.08); }
.theme-chunhuaqiushi .category-tile:active { background: rgba(143, 175, 152, 0.20); }
.theme-chunhuaqiushi .section-mark { color: #D5A84B; }
.theme-chunhuaqiushi .product-placeholder,
.theme-chunhuaqiushi .group-placeholder { color: #315B45; background: #EAF1E7; }
.theme-chunhuaqiushi .product-price,
.theme-chunhuaqiushi .group-price { color: #DF6B4F; }
.theme-chunhuaqiushi .product-stock.is-empty { color: #DF6B4F; }
.theme-chunhuaqiushi .retry-button { color: #FFFDF8; background: #315B45; border-radius: 999rpx; }
.theme-chunhuaqiushi .quick-action { color: #315B45; background: #FFFDF8; border: 1rpx solid rgba(49, 91, 69, 0.08); box-shadow: 0 8rpx 24rpx rgba(57, 76, 62, 0.06); }
.theme-chunhuaqiushi .quick-action-primary { background: #315B45; color: #FFFDF8; }
.theme-chunhuaqiushi .quick-action-primary .quick-desc { color: rgba(255, 253, 248, 0.74); }
.theme-chunhuaqiushi .quick-icon { color: #315B45; background: rgba(213, 168, 75, 0.18); }
.theme-chunhuaqiushi .quick-action-primary .quick-icon { color: #315B45; background: #D5A84B; }
