NODE_ENV=development
PORT=13080
DATABASE_URL="postgresql://postgres:postgres@localhost:15432/community_selection?schema=public"
ADMIN_TOKEN=dev-admin-token
ADMIN_AUTH_ENABLED=false
ADMIN_AUTH_MODE=token
ADMIN_TOTP_ENCRYPTION_KEY=
# 生产 session 模式必须配置强随机 ADMIN_TOTP_ENCRYPTION_KEY，且不要复用 ADMIN_TOKEN。
VITE_API_BASE_URL=http://localhost:13080
MINIAPP_API_BASE_URL=http://localhost:13080
MOCK_WECHAT_PAY=true
WECHAT_PAY_MODE=mock
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_MCH_ID=
WECHAT_MCH_SERIAL_NO=
WECHAT_API_V3_KEY=
WECHAT_PRIVATE_KEY_PATH=
WECHAT_PAY_PLATFORM_SERIAL_NO=
WECHAT_PAY_PLATFORM_CERT_PATH=
WECHAT_PAY_NOTIFY_URL=
WECHAT_REFUND_NOTIFY_URL=
USER_SESSION_TOKEN_SECRET=
CURRENT_USER_MOCK_HEADERS_ENABLED=true
AUTO_PAYOUT_ENABLED=false
AUTO_TAX_FILING_ENABLED=false
