# Copy to .env.production. Never commit the populated file.
NODE_ENV=production
IMAGE_TAG=replace-with-git-sha
PORT=13080

API_DOMAIN=api.example.com
ADMIN_DOMAIN=admin.example.com
ACME_EMAIL=ops@example.com

POSTGRES_DB=community_selection
POSTGRES_USER=community_selection
# Use URL-safe random text, at least 32 characters: openssl rand -base64 48 | tr -d '=+/' | cut -c1-48
POSTGRES_PASSWORD=replace-with-url-safe-random-password
DATABASE_URL=postgresql://community_selection:replace-with-url-safe-random-password@postgres:5432/community_selection?schema=public
MEMBER_PHONE_HMAC_SECRET=replace-with-an-independent-secret-of-at-least-32-characters

ADMIN_AUTH_ENABLED=true
ADMIN_AUTH_MODE=session
ADMIN_TOKEN=replace-with-independent-random-secret
ADMIN_TOTP_ENCRYPTION_KEY=replace-with-independent-random-secret

WECHAT_PAY_MODE=wechat
MOCK_WECHAT_PAY=false
CURRENT_USER_MOCK_HEADERS_ENABLED=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_MCH_ID=
WECHAT_MCH_SERIAL_NO=
WECHAT_API_V3_KEY=
WECHAT_PRIVATE_KEY_PATH=/run/secrets/wechat_private_key.pem
WECHAT_PAY_PLATFORM_SERIAL_NO=
WECHAT_PAY_PLATFORM_CERT_PATH=/run/secrets/wechat_platform_certificate.pem
WECHAT_PAY_NOTIFY_URL=https://api.example.com/api/payments/wechat/notify
WECHAT_REFUND_NOTIFY_URL=https://api.example.com/api/refunds/wechat/notify
MINIAPP_API_BASE_URL=https://api.example.com
USER_SESSION_TOKEN_SECRET=replace-with-independent-random-secret

FIRST_LAUNCH_MODE=true
MEMBERSHIP_ENABLED=false
COUPONS_ENABLED=false
CASH_REWARDS_ENABLED=false
WITHDRAWALS_ENABLED=false

AUTO_PAYOUT_ENABLED=false
AUTO_TAX_FILING_ENABLED=false
WECHAT_TRANSFER_ENABLED=false
WECHAT_MERCHANT_TRANSFER_ENABLED=false

BACKUP_DIR=/var/backups/community-selection
BACKUP_RETENTION_DAYS=14
BACKUP_ENCRYPTION_PASSPHRASE_FILE=/run/secrets/backup_passphrase
